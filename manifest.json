{
  "manifest_version": 3,
  "name": "Cloudflare Free Quota Monitor",
  "description": "Monitors Cloudflare free-tier quotas across Workers, Pages, KV, D1, R2, Durable Objects and related developer products.",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.cloudflare.com/*",
    "*://*/*"
  ],
  "action": {
    "default_title": "Quota Monitor",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
